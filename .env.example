NIVIEW_ACCOUNT=alice@example.com
NIVIEW_HOST=cloud-us1.niceviewer.com
NIVIEW_TOKEN=replace-with-a-token-from-auth-login
NIVIEW_TOKEN_AT=0

# Optional 1Password references used by `auth login --mode 1password`.
# These are references, not secrets.
NIVIEW_OP_ACCOUNT=op://your-vault/your-item/username
NIVIEW_OP_PASSWORD=op://your-vault/your-item/password
